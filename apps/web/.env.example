# Copy to .env.local — Vite prefers existing env vars over code defaults.

# Recommended for development with local Postgres (`make migrate` + catalog seed).
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_KEY=

# Optional: point at deployed read API (won't include DB state you haven't shipped).
# VITE_API_BASE_URL=https://watari-api.fly.dev
